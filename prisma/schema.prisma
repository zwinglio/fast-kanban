datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Board {
  id                  String     @id @db.VarChar(12) // nanoid public slug (URL)
  title               String     @db.VarChar(255)
  prefix              String     @db.VarChar(16) // e.g. "PROJ"
  editHash            String     @map("edit_hash") @db.VarChar(255) // scrypt: salt:hash
  nextSeq             Int        @default(1) @map("next_seq") // per-board card counter
  pointsEnabled       Boolean    @default(false) @map("points_enabled") // story points are opt-in per board
  dependenciesEnabled Boolean    @default(false) @map("dependencies_enabled") // "blocked by" links are opt-in per board
  createdAt           DateTime   @default(now()) @map("created_at")
  cards               Card[]
  tags                Tag[]
  columns             Column[]
  priorities          Priority[]

  @@map("boards")
}

model Tag {
  id      Int    @id @default(autoincrement())
  boardId String @map("board_id") @db.VarChar(12)
  name    String @db.VarChar(50)
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards   Card[]

  @@unique([boardId, name]) // no duplicate tag names per board
  @@map("tags")
}

model Column {
  id       Int    @id @default(autoincrement())
  boardId  String @map("board_id") @db.VarChar(12)
  name     String @db.VarChar(50)
  color    String @db.VarChar(7)
  position Int    @default(0)
  board    Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards    Card[]

  @@index([boardId])
  @@map("board_columns")
}

model Priority {
  id       Int    @id @default(autoincrement())
  boardId  String @map("board_id") @db.VarChar(12)
  name     String @db.VarChar(30)
  color    String @db.VarChar(7)
  position Int    @default(0) // 0 = most urgent
  board    Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards    Card[]

  @@index([boardId])
  @@map("priorities")
}

model CardEvent {
  id        Int      @id @default(autoincrement())
  cardId    Int      @map("card_id")
  boardId   String   @map("board_id") @db.VarChar(12)
  type      String   @db.VarChar(32) // created | moved | title | description | priority | tags | archived | restored
  data      Json? // names captured at the time, so renames/deletes don't rewrite history
  createdAt DateTime @default(now()) @map("created_at")
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, id])
  @@map("card_events")
}

// "blocked is blocked by blocker" — the same link reads as "blocker blocks blocked".
model CardDependency {
  id        Int      @id @default(autoincrement())
  boardId   String   @map("board_id") @db.VarChar(12)
  blockedId Int      @map("blocked_id")
  blockerId Int      @map("blocker_id")
  createdAt DateTime @default(now()) @map("created_at")
  blocked   Card     @relation("BlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)
  blocker   Card     @relation("Blocks", fields: [blockerId], references: [id], onDelete: Cascade)

  @@unique([blockedId, blockerId])
  @@index([boardId])
  @@index([blockerId])
  @@map("card_dependencies")
}

model Card {
  id         Int              @id @default(autoincrement())
  boardId    String           @map("board_id") @db.VarChar(12)
  seq        Int // display id = prefix + "-" + seq
  title      String           @db.VarChar(255)
  body       String?          @db.MediumText // markdown
  columnId   Int              @map("column_id")
  priorityId Int?             @map("priority_id")
  points     Int? // story points; null = not estimated
  position   Int              @default(0) // order within a column
  archivedAt DateTime?        @map("archived_at") // null = active; archived cards are hidden by default
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  board      Board            @relation(fields: [boardId], references: [id], onDelete: Cascade)
  column     Column           @relation(fields: [columnId], references: [id])
  priority   Priority?        @relation(fields: [priorityId], references: [id], onDelete: SetNull)
  tags       Tag[]
  events     CardEvent[]
  blockedBy  CardDependency[] @relation("BlockedBy")
  blocks     CardDependency[] @relation("Blocks")

  @@unique([boardId, seq])
  @@index([boardId, columnId])
  @@index([priorityId])
  @@map("cards")
}
